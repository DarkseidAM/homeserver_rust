{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "minimumReleaseAge": null
    },
    "internalChecksFilter": "strict",
    "minimumReleaseAge": "3 days",
    "rangeStrategy": "update-lockfile",
    "prConcurrentLimit": 5,
    "packageRules": [
        {
            "description": "Group post-1.0 non-major Cargo updates",
            "matchManagers": ["cargo"],
            "matchCurrentVersion": ">=1.0.0",
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "rust-dependencies-minor",
            "automerge": true,
            "platformAutomerge": true
        },
        {
            "description": "Group pre-1.0 patch-only updates (safe under Cargo SemVer)",
            "matchManagers": ["cargo"],
            "matchCurrentVersion": "^0.",
            "matchUpdateTypes": ["patch"],
            "groupName": "rust-dependencies-patches",
            "automerge": true,
            "platformAutomerge": true
        },
        {
            "description": "Never automerge breaking 0.x updates for pre-1.0 crates",
            "matchManagers": ["cargo"],
            "matchCurrentVersion": "^0.",
            "matchUpdateTypes": ["minor"],
            "automerge": false
        },
        {
            "description": "Never automerge major updates for core crates",
            "matchManagers": ["cargo"],
            "matchPackageNames": [
                "tokio",
                "axum",
                "sqlx",
                "bollard",
                "serde",
                "tower-http"
            ],
            "matchUpdateTypes": ["major"],
            "automerge": false
        },
        {
            "description": "Automerge only non-major GitHub Actions",
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "patch"],
            "automerge": true,
            "platformAutomerge": true
        }
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "platformAutomerge": true,
        "rebaseWhen": "behind-base-branch",
        "schedule": [
            "before 5am on monday"
        ]
    }
}
